<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Human-readable pattern (local/test). %X{request_id} prints the request id from the MDC. -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %5p [%15.15t] [%X{request_id:-}] %-40.40logger{39} : %m%n%wEx"/>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="local | test">
        <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- Everywhere else (Docker, CI, prod): one JSON object per line. Every MDC key
         (request_id, client_id, event_id) becomes a JSON field automatically. -->
    <springProfile name="!local &amp; !test">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
